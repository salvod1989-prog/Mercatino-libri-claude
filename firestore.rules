// ============================================================
// FIRESTORE SECURITY RULES
// File: firestore.rules
// Copia questo contenuto in Firebase Console →
// Firestore Database → Regole
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper functions ---

    // Utente autenticato
    function autenticato() {
      return request.auth != null;
    }

    // Controlla se l'utente è admin
    function isAdmin() {
      return autenticato() &&
        get(/databases/$(database)/documents/utenti/$(request.auth.uid)).data.ruolo == 'admin';
    }

    // Controlla se il documento appartiene all'utente corrente
    function proprietario(uid) {
      return autenticato() && request.auth.uid == uid;
    }

    // --- Collezione: utenti ---
    match /utenti/{uid} {
      // Lettura: solo il proprietario o admin
      allow read: if proprietario(uid) || isAdmin();

      // Creazione: solo al momento della registrazione (uid == auth.uid)
      allow create: if proprietario(uid)
        && request.resource.data.keys().hasAll(['nome', 'cognome', 'ruolo'])
        && request.resource.data.ruolo == 'studente';

      // Aggiornamento: solo il proprietario (non può cambiare il ruolo)
      allow update: if proprietario(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ruolo']);

      // Cancellazione: solo admin
      allow delete: if isAdmin();
    }

    // --- Collezione: libri ---
    match /libri/{libroId} {
      // Lettura: tutti (anche non autenticati — il catalogo è pubblico)
      allow read: if true;

      // Creazione: solo utenti autenticati, devono essere il venditore
      allow create: if autenticato()
        && request.resource.data.venditore_id == request.auth.uid
        && request.resource.data.keys().hasAll([
             'titolo', 'autore', 'materia', 'classe', 'indirizzo',
             'prezzo', 'stato_libro', 'venditore_id', 'stato_annuncio'
           ])
        && request.resource.data.stato_annuncio == 'disponibile'
        && request.resource.data.prezzo >= 0
        && request.resource.data.prezzo <= 500;

      // Aggiornamento: il venditore può modificare i suoi libri; admin può tutto
      allow update: if (autenticato() && resource.data.venditore_id == request.auth.uid)
        || isAdmin();

      // Cancellazione: il venditore o l'admin
      allow delete: if (autenticato() && resource.data.venditore_id == request.auth.uid)
        || isAdmin();
    }

    // --- Collezione: prenotazioni ---
    match /prenotazioni/{prenId} {
      // Lettura: l'acquirente, il venditore del libro prenotato, o admin
      allow read: if autenticato() && (
        resource.data.acquirente_id == request.auth.uid
        || get(/databases/$(database)/documents/libri/$(resource.data.libro_id)).data.venditore_id == request.auth.uid
        || isAdmin()
      );

      // Creazione: solo l'acquirente, con campi obbligatori
      allow create: if autenticato()
        && request.resource.data.acquirente_id == request.auth.uid
        && request.resource.data.keys().hasAll(['libro_id', 'acquirente_id', 'metodo_pagamento'])
        && request.resource.data.stato_prenotazione == 'in_attesa';

      // Aggiornamento: acquirente o venditore del libro, o admin
      allow update: if autenticato() && (
        resource.data.acquirente_id == request.auth.uid
        || get(/databases/$(database)/documents/libri/$(resource.data.libro_id)).data.venditore_id == request.auth.uid
        || isAdmin()
      );

      // Cancellazione: solo admin
      allow delete: if isAdmin();
    }

    // --- Collezione: segnalazioni ---
    match /segnalazioni/{segId} {
      // Lettura: solo admin
      allow read: if isAdmin();

      // Creazione: qualsiasi utente autenticato
      allow create: if autenticato()
        && request.resource.data.segnalato_da == request.auth.uid
        && request.resource.data.motivo.size() >= 10;

      // Aggiornamento/cancellazione: solo admin
      allow update, delete: if isAdmin();
    }
  }
}


// ============================================================
// STORAGE SECURITY RULES
// File: storage.rules
// Copia in Firebase Console → Storage → Regole
// ============================================================

/*

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Copertine libri: lettura pubblica, scrittura solo dall'owner
    match /copertine/{libroId} {
      // Chiunque può vedere le copertine
      allow read: if true;

      // Solo utenti autenticati possono caricare
      allow write: if request.auth != null
        // Dimensione massima: 5 MB
        && request.resource.size < 5 * 1024 * 1024
        // Solo immagini
        && request.resource.contentType.matches('image/.*');

      // Solo admin possono eliminare
      allow delete: if request.auth != null
        && firestore.get(
             /databases/(default)/documents/utenti/$(request.auth.uid)
           ).data.ruolo == 'admin';
    }

    // Tutto il resto: vietato
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

*/
